/* OpenFOAM v2512 compressible VOF - Case B matched-physics 2-D sensitivity. */
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
application     compressibleInterFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

// T* = t * sqrt(g*Dt)/L ; T*=6 → t≈10.4 s. Cover past Fig.6/8 window.
// t=8.65 s gives T*=5.005 and covers the published Fig. 6/8 window.
endTime         8.65;

deltaT          1e-5;

writeControl    adjustableRunTime;

writeInterval   0.05;

purgeWrite      0;

writeFormat     binary;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   10;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.35;

maxAlphaCo      0.25;

maxDeltaT       0.001;

functions
{
    transducer
    {
        type            probes;
        libs            (sampling);
        fields          (p p_rgh alpha.water U);
        // VW: transducer in main pipe near invert, mid-chamber-to-tower reach
        probeLocations
        (
            (1.616 -0.043 0)
        );
        writeControl    adjustableRunTime;
        writeInterval   0.005;
    }

    towerCentreline
    {
        type            probes;
        libs            (sampling);
        fields          (alpha.water U p);
        // Through the physical tower bore; the atmosphere patch is at y=0.657 m.
        probeLocations
        (
            (3.516 0.052 0) (3.516 0.062 0) (3.516 0.072 0)
            (3.516 0.082 0) (3.516 0.092 0) (3.516 0.102 0)
            (3.516 0.112 0) (3.516 0.122 0) (3.516 0.132 0)
            (3.516 0.142 0) (3.516 0.152 0) (3.516 0.162 0)
            (3.516 0.172 0) (3.516 0.182 0) (3.516 0.192 0)
            (3.516 0.202 0) (3.516 0.212 0) (3.516 0.222 0)
            (3.516 0.232 0) (3.516 0.242 0) (3.516 0.252 0)
            (3.516 0.262 0) (3.516 0.272 0) (3.516 0.282 0)
            (3.516 0.292 0) (3.516 0.302 0) (3.516 0.312 0)
            (3.516 0.322 0) (3.516 0.332 0) (3.516 0.342 0)
            (3.516 0.352 0) (3.516 0.362 0) (3.516 0.372 0)
            (3.516 0.382 0) (3.516 0.392 0) (3.516 0.402 0)
