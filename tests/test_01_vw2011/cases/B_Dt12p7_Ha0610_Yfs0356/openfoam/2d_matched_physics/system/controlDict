            (3.516 0.502 0) (3.516 0.512 0) (3.516 0.522 0)
            (3.516 0.532 0) (3.516 0.542 0) (3.516 0.552 0)
            (3.516 0.562 0) (3.516 0.572 0) (3.516 0.582 0)
            (3.516 0.592 0) (3.516 0.602 0) (3.516 0.612 0)
            (3.516 0.622 0) (3.516 0.632 0) (3.516 0.642 0)
            (3.516 0.652 0)
        );
        writeControl    adjustableRunTime;
        writeInterval   0.005;
    }
}

