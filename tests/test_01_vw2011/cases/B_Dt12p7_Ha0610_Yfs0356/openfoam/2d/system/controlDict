/* OpenFOAM v2512 compressible VOF — VW2011 Case B (paper centre panel). */
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
application     compressibleInterFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

// T* = t * sqrt(g*Dt)/L ; T*=6 → t≈10.4 s. Cover past Fig.6/8 window.
endTime         12.0;

deltaT          1e-5;

writeControl    adjustableRunTime;

writeInterval   0.05;

purgeWrite      0;

writeFormat     binary;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   10;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.20;

maxAlphaCo      0.15;

maxDeltaT       0.00025;

functions
{
    transducer
    {
        type            probes;
        libs            (sampling);
        fields          (p p_rgh alpha.water U);
        // VW: transducer in main pipe near invert, mid-chamber-to-tower reach
        probeLocations
        (
            (1.616 -0.043 0)
        );
        writeControl    adjustableRunTime;
        writeInterval   0.005;
    }

