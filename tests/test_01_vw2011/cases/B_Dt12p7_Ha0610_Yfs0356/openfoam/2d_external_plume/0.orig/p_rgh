FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 105271.3;

boundaryField
{
    walls
    {
        type            fixedFluxPressure;
    }

    atmosphere
    {
        type            prghPressure;
        p               uniform 101325;
        value           uniform 101325;
    }

    frontAndBack
    {
        type            empty;
    }
}


