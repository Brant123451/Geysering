FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     compressibleInterFlow;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
#include "runControl"

deltaT          1e-6;
purgeWrite      0;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   10;
runTimeModifiable yes;
adjustTimeStep  yes;

functions
{
    transducer
    {
        type            probes;
        libs            (sampling);
        fields          (p p_rgh alpha.water U);
        probeLocations
        (
            // Longitudinal location is reported.  Vertical tap position is
            // unresolved; this lower-wall coordinate follows the Case-A deck.
            (1.616 -0.043 0)
        );
        writeControl    adjustableRunTime;
        writeInterval   $caseBProbeInterval;
    }

    towerProfiles
    {
        type            probes;
        libs            (sampling);
        fields          (alpha.water U p);
        probeLocations
        (
            #include "towerProbeLocations"
        );
        writeControl    adjustableRunTime;
        writeInterval   $caseBProbeInterval;
    }

    plumeProfiles
    {
        type            probes;
        libs            (sampling);
        fields          (alpha.water U p);
        probeLocations
        (
            #include "plumeProbeLocations"
        );
        writeControl    adjustableRunTime;
        writeInterval   $caseBPlumeInterval;
    }

    phaseAccounting
    {
        type            coded;
        libs            (utilityFunctionObjects);
        name            caseBPhaseAccounting;
        executeControl  adjustableRunTime;
        executeInterval $caseBAccountingInterval;
        writeControl    writeTime;

        codeExecute
        #{
            const fvMesh& fvmesh = mesh();
            const volScalarField& alpha =
                fvmesh.lookupObject<volScalarField>("alpha.water");
            const volScalarField& waterDensity =
                fvmesh.lookupObject<volScalarField>("thermo:rho.water");
            const volScalarField& airDensity =
                fvmesh.lookupObject<volScalarField>("thermo:rho.air");
            const surfaceScalarField& phi =
                fvmesh.lookupObject<surfaceScalarField>("phi");
            const surfaceScalarField& waterAlphaPhi =
                fvmesh.lookupObject<surfaceScalarField>("alphaPhi.water");
            const volScalarField& mixtureDensity =
                fvmesh.lookupObject<volScalarField>("rho");
            const surfaceScalarField& mixtureMassFlux =
                fvmesh.lookupObject<surfaceScalarField>("rhoPhi");
            const scalarField& volume = fvmesh.V();
            const vectorField& centres = fvmesh.C();

            scalar liquidMass = 0;
            scalar gasMass = 0;
            scalar liquidVolume = 0;
            scalar totalMass = 0;
            scalar waterAboveRim = 0;
            scalar plumeTop = 0.657;
            forAll(volume, cellI)
            {
                // Preserve the transported alpha exactly so conservation
                // diagnostics expose, rather than hide, any bound violation.
                const scalar a = alpha[cellI];
                liquidMass += a*waterDensity[cellI]*volume[cellI];
                gasMass += (1.0-a)*airDensity[cellI]*volume[cellI];
                liquidVolume += a*volume[cellI];
                totalMass += mixtureDensity[cellI]*volume[cellI];
                if (centres[cellI].y() > 0.657)
                {
                    waterAboveRim += a*volume[cellI];
                    if (a >= 0.05)
                    {
                        plumeTop = max(plumeTop, centres[cellI].y());
                    }
                }
            }
            liquidMass = returnReduce(liquidMass, sumOp<scalar>());
            gasMass = returnReduce(gasMass, sumOp<scalar>());
            liquidVolume = returnReduce(liquidVolume, sumOp<scalar>());
            totalMass = returnReduce(totalMass, sumOp<scalar>());
            waterAboveRim = returnReduce(waterAboveRim, sumOp<scalar>());
            plumeTop = returnReduce(plumeTop, maxOp<scalar>());

            scalar liquidFlux = 0;
            scalar gasFlux = 0;
            scalar totalMassFlux = 0;
            const label patchI = fvmesh.boundaryMesh().findPatchID("atmosphere");
            if (patchI >= 0)
            {
                const scalarField& phip = phi.boundaryField()[patchI];
                const scalarField& alphaPhip =
                    waterAlphaPhi.boundaryField()[patchI];
                const scalarField& rhoWaterp =
                    waterDensity.boundaryField()[patchI];
                const scalarField& rhoAirp =
                    airDensity.boundaryField()[patchI];
                const scalarField& rhoPhip =
                    mixtureMassFlux.boundaryField()[patchI];
                forAll(phip, faceI)
                {
                    liquidFlux += rhoWaterp[faceI]*alphaPhip[faceI];
                    gasFlux +=
                        rhoAirp[faceI]*(phip[faceI] - alphaPhip[faceI]);
                    totalMassFlux += rhoPhip[faceI];
                }
            }
            liquidFlux = returnReduce(liquidFlux, sumOp<scalar>());
            gasFlux = returnReduce(gasFlux, sumOp<scalar>());
            totalMassFlux = returnReduce(totalMassFlux, sumOp<scalar>());

            if (Pstream::master())
            {
                Info<< "CASEB_ACCOUNTING "
                    << fvmesh.time().value() << ' '
                    << liquidMass << ' ' << gasMass << ' '
                    << liquidVolume << ' ' << waterAboveRim << ' '
                    << max(scalar(0), plumeTop - 0.657) << ' '
                    << liquidFlux << ' ' << gasFlux << ' '
                    << totalMass << ' ' << totalMassFlux << nl;
            }
        #};
    }

    solverBounds
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        fields          (alpha.water U);
        mode            magnitude;
        location        yes;
        writeToFile     no;
        log             yes;
        writeControl    adjustableRunTime;
        writeInterval   $caseBAccountingInterval;
    }
}
