FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setExprFieldsDict;
}

readFields (alpha.water p p_rgh T);

expressions
(
    atmosphericAirPressure
    {
        field p;
        dimensions [1 -1 -2 0 0 0 0];
        fieldMask
        #{
            (alpha.water < 0.5) && (pos().x() > 0.546)
        #};
        expression #{ 101325 #};
    }

    pocketAirPressure
    {
        field p;
        dimensions [1 -1 -2 0 0 0 0];
        fieldMask #{ pos().x() <= 0.546 #};
        expression #{ 107298.329 #};
    }

    hydrostaticWaterPressure
    {
        field p;
        dimensions [1 -1 -2 0 0 0 0];
        fieldMask #{ alpha.water >= 0.5 #};
        expression
        #{
            101325 + 998.2*9.81*(0.403 - pos().y())
        #};
    }

    mixtureReducedPressure
    {
        field p_rgh;
        dimensions [1 -1 -2 0 0 0 0];
        // compressibleInterFlow reconstructs p as p_rgh + rho*gh using
        // alpha-weighted phase density.  Use that same mixture density in
        // geometric cut cells instead of switching p_rgh at alpha=0.5.
        expression
        #{
            p
          + (
                alpha.water
               *(998.153943 + p/(7504.690432*293.15))
              + (1 - alpha.water)*(p/(287.058*293.15))
            )
           *9.81*pos().y()
        #};
    }
);
