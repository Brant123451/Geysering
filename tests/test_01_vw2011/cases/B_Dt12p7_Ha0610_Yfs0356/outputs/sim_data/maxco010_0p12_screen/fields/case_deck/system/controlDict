FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     compressibleInterFlow;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
#include "runControl"

deltaT          1e-6;
purgeWrite      0;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   10;
runTimeModifiable yes;
adjustTimeStep  yes;

functions
{
    transducer
    {
        type            probes;
        libs            (sampling);
        fields          (p p_rgh alpha.water U);
        probeLocations
        (
            // Longitudinal location is reported.  Vertical tap position is
            // unresolved; this lower-wall coordinate follows the Case-A deck.
            (1.616 -0.043 0)
        );
        writeControl    runTime;
        writeInterval   $caseBProbeInterval;
    }

    towerProfiles
    {
        type            probes;
        libs            (sampling);
        fields          (alpha.water U p);
        probeLocations
        (
            #include "towerProbeLocations"
        );
        writeControl    runTime;
        writeInterval   $caseBProbeInterval;
    }

    plumeProfiles
    {
        type            probes;
        libs            (sampling);
        fields          (alpha.water U p);
        probeLocations
        (
            #include "plumeProbeLocations"
        );
        writeControl    runTime;
        writeInterval   $caseBPlumeInterval;
    }

    phaseAccounting
    {
        type            coded;
        libs            (utilityFunctionObjects);
        name            caseBPhaseAccounting;
        executeControl  runTime;
        executeInterval $caseBAccountingInterval;
        writeControl    writeTime;

        codeInclude
        #{
            #include "fvcSnGrad.H"
            #include "surfaceInterpolate.H"
        #};

        codeExecute
        #{
            const fvMesh& fvmesh = mesh();
            const volScalarField& alpha =
                fvmesh.lookupObject<volScalarField>("alpha.water");
            const volVectorField& velocity =
                fvmesh.lookupObject<volVectorField>("U");
            const volScalarField& waterDensity =
                fvmesh.lookupObject<volScalarField>("thermo:rho.water");
            const volScalarField& airDensity =
                fvmesh.lookupObject<volScalarField>("thermo:rho.air");
            const surfaceScalarField& phi =
                fvmesh.lookupObject<surfaceScalarField>("phi");
            const surfaceScalarField& waterAlphaPhi =
                fvmesh.lookupObject<surfaceScalarField>("alphaPhi.water");
            const volScalarField& mixtureDensity =
                fvmesh.lookupObject<volScalarField>("rho");
            const volScalarField& pressure =
                fvmesh.lookupObject<volScalarField>("p");
            const volScalarField& reducedPressure =
                fvmesh.lookupObject<volScalarField>("p_rgh");
            const volScalarField& curvature =
                fvmesh.lookupObject<volScalarField>("K_");
            const surfaceScalarField& ghf =
                fvmesh.lookupObject<surfaceScalarField>("ghf");
            const surfaceScalarField& mixtureMassFlux =
                fvmesh.lookupObject<surfaceScalarField>("rhoPhi");
            const scalarField& volume = fvmesh.V();
            const vectorField& centres = fvmesh.C();

            scalar liquidMass = 0;
            scalar gasMass = 0;
            scalar liquidVolume = 0;
            scalar totalMass = 0;
            scalar waterAboveRim = 0;
            scalar plumeTop = 0.657;
            scalar minAlpha = GREAT;
            scalar maxAlpha = -GREAT;
            scalar localMaxVelocity = -GREAT;
            vector localMaxVelocityLocation = vector::zero;
            label localMaxVelocityCell = -1;
            forAll(volume, cellI)
            {
                // Preserve the transported alpha exactly so conservation
                // diagnostics expose, rather than hide, any bound violation.
                const scalar a = alpha[cellI];
                const scalar speed = mag(velocity[cellI]);
                liquidMass += a*waterDensity[cellI]*volume[cellI];
                gasMass += (1.0-a)*airDensity[cellI]*volume[cellI];
                liquidVolume += a*volume[cellI];
                totalMass += mixtureDensity[cellI]*volume[cellI];
                minAlpha = min(minAlpha, a);
                maxAlpha = max(maxAlpha, a);
                if (speed > localMaxVelocity)
                {
                    localMaxVelocity = speed;
                    localMaxVelocityLocation = centres[cellI];
                    localMaxVelocityCell = cellI;
                }
                if (centres[cellI].y() > 0.657)
                {
                    waterAboveRim += a*volume[cellI];
                    if (a >= 0.05)
                    {
                        plumeTop = max(plumeTop, centres[cellI].y());
                    }
                }
            }
            liquidMass = returnReduce(liquidMass, sumOp<scalar>());
            gasMass = returnReduce(gasMass, sumOp<scalar>());
            liquidVolume = returnReduce(liquidVolume, sumOp<scalar>());
            totalMass = returnReduce(totalMass, sumOp<scalar>());
            waterAboveRim = returnReduce(waterAboveRim, sumOp<scalar>());
            plumeTop = returnReduce(plumeTop, maxOp<scalar>());
            minAlpha = returnReduce(minAlpha, minOp<scalar>());
            maxAlpha = returnReduce(maxAlpha, maxOp<scalar>());
            const scalar maxVelocity =
                returnReduce(localMaxVelocity, maxOp<scalar>());
            label maxVelocityProc =
                localMaxVelocity == maxVelocity
              ? Pstream::myProcNo()
              : Pstream::nProcs();
            maxVelocityProc =
                returnReduce(maxVelocityProc, minOp<label>());
            vector maxVelocityLocation =
                Pstream::myProcNo() == maxVelocityProc
              ? localMaxVelocityLocation
              : vector::zero;
            maxVelocityLocation =
                returnReduce(maxVelocityLocation, sumOp<vector>());
            const bool ownsMaxVelocity =
                Pstream::myProcNo() == maxVelocityProc;
            const scalar maxVelocityAlpha = returnReduce
            (
                ownsMaxVelocity ? alpha[localMaxVelocityCell] : scalar(0),
                sumOp<scalar>()
            );
            const scalar maxVelocityDensity = returnReduce
            (
                ownsMaxVelocity
              ? mixtureDensity[localMaxVelocityCell]
              : scalar(0),
                sumOp<scalar>()
            );
            const scalar maxVelocityCurvature = returnReduce
            (
                ownsMaxVelocity ? curvature[localMaxVelocityCell] : scalar(0),
                sumOp<scalar>()
            );
            const scalar maxVelocityPressure = returnReduce
            (
                ownsMaxVelocity ? pressure[localMaxVelocityCell] : scalar(0),
                sumOp<scalar>()
            );
            const scalar maxVelocityReducedPressure = returnReduce
            (
                ownsMaxVelocity
              ? reducedPressure[localMaxVelocityCell]
              : scalar(0),
                sumOp<scalar>()
            );
            const label maxVelocityCell = returnReduce
            (
                ownsMaxVelocity ? localMaxVelocityCell : label(-1),
                maxOp<label>()
            );

            const dimensionedScalar sigma
            (
                "sigma",
                dimensionSet(1, 0, -2, 0, 0, 0, 0),
                0.072
            );
            const surfaceScalarField hydrostaticForceResidual
            (
                "caseBHydrostaticForceResidual",
               -ghf*fvc::snGrad(mixtureDensity)
              - fvc::snGrad(reducedPressure)
            );
            const surfaceScalarField surfaceTensionForce
            (
                "caseBSurfaceTensionForce",
                sigma*fvc::interpolate(curvature)*fvc::snGrad(alpha)
            );
            const surfaceScalarField totalForceResidual
            (
                "caseBTotalForceResidual",
                hydrostaticForceResidual + surfaceTensionForce
            );

            scalar localMaxHydrostaticForce = -GREAT;
            scalar localMaxSurfaceTensionForce = -GREAT;
            scalar localMaxTotalForce = -GREAT;
            scalar localHydrostaticForceValue = 0;
            scalar localSurfaceTensionForceValue = 0;
            scalar localTotalForceValue = 0;
            vector localHydrostaticForceLocation = vector::zero;
            vector localSurfaceTensionForceLocation = vector::zero;
            vector localTotalForceLocation = vector::zero;
            for (label faceI = 0; faceI < fvmesh.nInternalFaces(); ++faceI)
            {
                const scalar hydrostaticMagnitude =
                    mag(hydrostaticForceResidual[faceI]);
                const scalar surfaceMagnitude =
                    mag(surfaceTensionForce[faceI]);
                const scalar totalMagnitude = mag(totalForceResidual[faceI]);
                if (hydrostaticMagnitude > localMaxHydrostaticForce)
                {
                    localMaxHydrostaticForce = hydrostaticMagnitude;
                    localHydrostaticForceValue =
                        hydrostaticForceResidual[faceI];
                    localHydrostaticForceLocation = fvmesh.Cf()[faceI];
                }
                if (surfaceMagnitude > localMaxSurfaceTensionForce)
                {
                    localMaxSurfaceTensionForce = surfaceMagnitude;
                    localSurfaceTensionForceValue =
                        surfaceTensionForce[faceI];
                    localSurfaceTensionForceLocation = fvmesh.Cf()[faceI];
                }
                if (totalMagnitude > localMaxTotalForce)
                {
                    localMaxTotalForce = totalMagnitude;
                    localTotalForceValue = totalForceResidual[faceI];
                    localTotalForceLocation = fvmesh.Cf()[faceI];
                }
            }

            const scalar maxHydrostaticForce = returnReduce
            (
                localMaxHydrostaticForce,
                maxOp<scalar>()
            );
            label maxHydrostaticForceProc =
                localMaxHydrostaticForce == maxHydrostaticForce
              ? Pstream::myProcNo()
              : Pstream::nProcs();
            maxHydrostaticForceProc = returnReduce
            (
                maxHydrostaticForceProc,
                minOp<label>()
            );
            scalar hydrostaticForceValue = returnReduce
            (
                Pstream::myProcNo() == maxHydrostaticForceProc
              ? localHydrostaticForceValue
              : scalar(0),
                sumOp<scalar>()
            );
            vector hydrostaticForceLocation = returnReduce
            (
                Pstream::myProcNo() == maxHydrostaticForceProc
              ? localHydrostaticForceLocation
              : vector::zero,
                sumOp<vector>()
            );

            const scalar maxSurfaceTensionForce = returnReduce
            (
                localMaxSurfaceTensionForce,
                maxOp<scalar>()
            );
            label maxSurfaceTensionForceProc =
                localMaxSurfaceTensionForce == maxSurfaceTensionForce
              ? Pstream::myProcNo()
              : Pstream::nProcs();
            maxSurfaceTensionForceProc = returnReduce
            (
                maxSurfaceTensionForceProc,
                minOp<label>()
            );
            scalar surfaceTensionForceValue = returnReduce
            (
                Pstream::myProcNo() == maxSurfaceTensionForceProc
              ? localSurfaceTensionForceValue
              : scalar(0),
                sumOp<scalar>()
            );
            vector surfaceTensionForceLocation = returnReduce
            (
                Pstream::myProcNo() == maxSurfaceTensionForceProc
              ? localSurfaceTensionForceLocation
              : vector::zero,
                sumOp<vector>()
            );

            const scalar maxTotalForce = returnReduce
            (
                localMaxTotalForce,
                maxOp<scalar>()
            );
            label maxTotalForceProc =
                localMaxTotalForce == maxTotalForce
              ? Pstream::myProcNo()
              : Pstream::nProcs();
            maxTotalForceProc = returnReduce
            (
                maxTotalForceProc,
                minOp<label>()
            );
            scalar totalForceValue = returnReduce
            (
                Pstream::myProcNo() == maxTotalForceProc
              ? localTotalForceValue
              : scalar(0),
                sumOp<scalar>()
            );
            vector totalForceLocation = returnReduce
            (
                Pstream::myProcNo() == maxTotalForceProc
              ? localTotalForceLocation
              : vector::zero,
                sumOp<vector>()
            );

            scalar liquidFlux = 0;
            scalar gasFlux = 0;
            scalar totalMassFlux = 0;
            const label patchI = fvmesh.boundaryMesh().findPatchID("atmosphere");
            if (patchI >= 0)
            {
                const scalarField& phip = phi.boundaryField()[patchI];
                const scalarField& alphaPhip =
                    waterAlphaPhi.boundaryField()[patchI];
                const scalarField& rhoWaterp =
                    waterDensity.boundaryField()[patchI];
                const scalarField& rhoAirp =
                    airDensity.boundaryField()[patchI];
                const scalarField& rhoPhip =
                    mixtureMassFlux.boundaryField()[patchI];
                forAll(phip, faceI)
                {
                    liquidFlux += rhoWaterp[faceI]*alphaPhip[faceI];
                    gasFlux +=
                        rhoAirp[faceI]*(phip[faceI] - alphaPhip[faceI]);
                    totalMassFlux += rhoPhip[faceI];
                }
            }
            liquidFlux = returnReduce(liquidFlux, sumOp<scalar>());
            gasFlux = returnReduce(gasFlux, sumOp<scalar>());
            totalMassFlux = returnReduce(totalMassFlux, sumOp<scalar>());

            if (Pstream::master())
            {
                Info<< "CASEB_ACCOUNTING "
                    << fvmesh.time().value() << ' '
                    << liquidMass << ' ' << gasMass << ' '
                    << liquidVolume << ' ' << waterAboveRim << ' '
                    << max(scalar(0), plumeTop - 0.657) << ' '
                    << liquidFlux << ' ' << gasFlux << ' '
                    << totalMass << ' ' << totalMassFlux << nl;
                Info<< "CASEB_BOUNDS "
                    << "Min(alpha.water) = " << minAlpha << ' '
                    << "Max(alpha.water) = " << maxAlpha << ' '
                    << "max(mag(U)) = " << maxVelocity
                    << " at location " << maxVelocityLocation
                    << " alphaAtMax = " << maxVelocityAlpha
                    << " rhoAtMax = " << maxVelocityDensity
                    << " KAtMax = " << maxVelocityCurvature
                    << " pAtMax = " << maxVelocityPressure
                    << " p_rghAtMax = " << maxVelocityReducedPressure
                    << " proc = " << maxVelocityProc
                    << " cell = " << maxVelocityCell << nl;
                Info<< "CASEB_FORCE_BALANCE "
                    << "maxHydrostatic(Pa/m) = " << maxHydrostaticForce
                    << " signed = " << hydrostaticForceValue
                    << " at location " << hydrostaticForceLocation << ' '
                    << "maxSurface(Pa/m) = " << maxSurfaceTensionForce
                    << " signed = " << surfaceTensionForceValue
                    << " at location " << surfaceTensionForceLocation << ' '
                    << "maxTotal(Pa/m) = " << maxTotalForce
                    << " signed = " << totalForceValue
                    << " at location " << totalForceLocation << nl;
            }
        #};
    }
}
