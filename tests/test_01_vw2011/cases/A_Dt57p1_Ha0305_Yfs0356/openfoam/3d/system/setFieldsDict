/* Initial state for Vasconcelos & Wright (2011), Case A.
   Air chamber: x <= 0.546 m, gauge head Ha0 = 0.305 m.
   Tower free surface: 0.356 m above the pipe crown (absolute y = 0.403 m).
   All remaining apparatus volume is initially water filled and at rest. */
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}

defaultFieldValues
(
    volScalarFieldValue alpha.water 1
    volScalarFieldValue p_rgh 105271.3
    volScalarFieldValue p 105271.3
    volScalarFieldValue T 293.15
);

regions
(
    boxToCell
    {
        box (-1 -1 -1) (0.546 1 1);
        fieldValues
        (
            volScalarFieldValue alpha.water 0
            volScalarFieldValue p_rgh 104311.7
            volScalarFieldValue p 104311.7
        );
    }

    // Tower headspace plus the external atmosphere above the physical rim.
    boxToCell
    {
        box (3.30 0.403 -0.20) (3.72 2.0 0.20);
        fieldValues
        (
            volScalarFieldValue alpha.water 0
            volScalarFieldValue p_rgh 101330
            volScalarFieldValue p 101325
        );
    }
);
