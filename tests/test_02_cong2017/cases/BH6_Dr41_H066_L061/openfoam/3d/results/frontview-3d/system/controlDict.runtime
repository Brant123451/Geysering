// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     compressibleInterFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         13;

deltaT          1e-08;

writeControl    adjustableRunTime;

writeInterval   0.1;

purgeWrite      3;

writeFormat     binary;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   10;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.5;

maxAlphaCo      0.50;

maxDeltaT       0.001;

functions
{
    PT1
    {
        type            probes;
        libs            ( sampling );
        fields          ( p p_rgh alpha.water U T );
        interpolationScheme cellPoint;
        probeLocations  ( ( 6.56 0 0.022 ) );
        writeControl    adjustableRunTime;
        writeInterval   0.01;
    }
    PT2
    {
        type            probes;
        libs            ( sampling );
        fields          ( p p_rgh alpha.water U T );
        interpolationScheme cellPoint;
        probeLocations  ( ( 3.47 0 -0.022 ) );
        writeControl    adjustableRunTime;
        writeInterval   0.01;
    }
    riserCentreline
    {
        type            probes;
        libs            ( sampling );
        fields          ( alpha.water U p );
        interpolationScheme cellPoint;
        probeLocations  ( ( 3.47 0 0.035 ) ( 3.47 0 0.055 ) ( 3.47 0 0.075 ) ( 3.47 0 0.095 ) ( 3.47 0 0.115 ) ( 3.47 0 0.135 ) ( 3.47 0 0.155 ) ( 3.47 0 0.175 ) ( 3.47 0 0.195 ) ( 3.47 0 0.215 ) ( 3.47 0 0.235 ) ( 3.47 0 0.255 ) ( 3.47 0 0.275 ) ( 3.47 0 0.295 ) ( 3.47 0 0.315 ) ( 3.47 0 0.335 ) ( 3.47 0 0.355 ) ( 3.47 0 0.375 ) ( 3.47 0 0.395 ) ( 3.47 0 0.415 ) ( 3.47 0 0.435 ) ( 3.47 0 0.455 ) ( 3.47 0 0.475 ) ( 3.47 0 0.495 ) ( 3.47 0 0.515 ) ( 3.47 0 0.535 ) ( 3.47 0 0.555 ) ( 3.47 0 0.575 ) ( 3.47 0 0.595 ) ( 3.47 0 0.615 ) ( 3.47 0 0.635 ) ( 3.47 0 0.655 ) ( 3.47 0 0.675 ) ( 3.47 0 0.695 ) ( 3.47 0 0.715 ) ( 3.47 0 0.735 ) ( 3.47 0 0.755 ) ( 3.47 0 0.775 ) ( 3.47 0 0.795 ) ( 3.47 0 0.815 ) ( 3.47 0 0.835 ) ( 3.47 0 0.855 ) ( 3.47 0 0.875 ) ( 3.47 0 0.895 ) ( 3.47 0 0.915 ) ( 3.47 0 0.935 ) ( 3.47 0 0.955 ) ( 3.47 0 0.975 ) ( 3.47 0 0.995 ) ( 3.47 0 1.015 ) ( 3.47 0 1.035 ) ( 3.47 0 1.055 ) ( 3.47 0 1.075 ) ( 3.47 0 1.095 ) ( 3.47 0 1.115 ) ( 3.47 0 1.135 ) ( 3.47 0 1.155 ) ( 3.47 0 1.175 ) ( 3.47 0 1.195 ) ( 3.47 0 1.215 ) ( 3.47 0 1.235 ) ( 3.47 0 1.255 ) ( 3.47 0 1.275 ) ( 3.47 0 1.295 ) ( 3.47 0 1.315 ) ( 3.47 0 1.335 ) ( 3.47 0 1.355 ) ( 3.47 0 1.375 ) ( 3.47 0 1.395 ) ( 3.47 0 1.415 ) ( 3.47 0 1.435 ) ( 3.47 0 1.455 ) ( 3.47 0 1.475 ) ( 3.47 0 1.495 ) ( 3.47 0 1.515 ) ( 3.47 0 1.535 ) ( 3.47 0 1.555 ) ( 3.47 0 1.575 ) ( 3.47 0 1.595 ) ( 3.47 0 1.615 ) ( 3.47 0 1.635 ) ( 3.47 0 1.655 ) ( 3.47 0 1.675 ) ( 3.47 0 1.695 ) ( 3.47 0 1.715 ) ( 3.47 0 1.735 ) ( 3.47 0 1.755 ) ( 3.47 0 1.775 ) ( 3.47 0 1.795 ) ( 3.47 0 1.815 ) );
        writeControl    adjustableRunTime;
        writeInterval   0.01;
    }
    plumeCentreline
    {
        type            probes;
        libs            ( sampling );
        fields          ( alpha.water U p );
        interpolationScheme cellPoint;
        probeLocations  ( ( 3.47 0 1.835 ) ( 3.47 0 1.855 ) ( 3.47 0 1.875 ) ( 3.47 0 1.895 ) ( 3.47 0 1.915 ) ( 3.47 0 1.935 ) ( 3.47 0 1.955 ) ( 3.47 0 1.975 ) ( 3.47 0 1.995 ) ( 3.47 0 2.015 ) ( 3.47 0 2.035 ) ( 3.47 0 2.055 ) ( 3.47 0 2.075 ) ( 3.47 0 2.095 ) ( 3.47 0 2.115 ) ( 3.47 0 2.135 ) ( 3.47 0 2.155 ) ( 3.47 0 2.175 ) ( 3.47 0 2.195 ) ( 3.47 0 2.215 ) ( 3.47 0 2.235 ) ( 3.47 0 2.255 ) ( 3.47 0 2.275 ) ( 3.47 0 2.295 ) ( 3.47 0 2.315 ) ( 3.47 0 2.335 ) ( 3.47 0 2.355 ) ( 3.47 0 2.375 ) ( 3.47 0 2.395 ) ( 3.47 0 2.415 ) ( 3.47 0 2.435 ) ( 3.47 0 2.455 ) ( 3.47 0 2.475 ) ( 3.47 0 2.495 ) ( 3.47 0 2.515 ) ( 3.47 0 2.535 ) ( 3.47 0 2.555 ) ( 3.47 0 2.575 ) ( 3.47 0 2.595 ) ( 3.47 0 2.615 ) ( 3.47 0 2.635 ) ( 3.47 0 2.655 ) ( 3.47 0 2.675 ) ( 3.47 0 2.695 ) ( 3.47 0 2.715 ) ( 3.47 0 2.735 ) ( 3.47 0 2.755 ) ( 3.47 0 2.775 ) ( 3.47 0 2.795 ) ( 3.47 0 2.815 ) ( 3.47 0 2.835 ) ( 3.47 0 2.855 ) ( 3.47 0 2.875 ) ( 3.47 0 2.895 ) ( 3.47 0 2.915 ) ( 3.47 0 2.935 ) ( 3.47 0 2.955 ) ( 3.47 0 2.975 ) ( 3.47 0 2.995 ) ( 3.47 0 3.015 ) );
        writeControl    adjustableRunTime;
        writeInterval   0.02;
    }
    frontViewCut
    {
        type            surfaces;
        libs            ( sampling );
        writeControl    adjustableRunTime;
        writeInterval   0.1;
        surfaceFormat   vtk;
        fields          ( alpha.water );
        interpolationScheme cellPoint;
        surfaces
        {
            yMid
            {
                type            cuttingPlane;
                point           ( 3.47 0 0 );
                normal          ( 0 1 0 );
                interpolate     true;
            }
        }
    }
}


