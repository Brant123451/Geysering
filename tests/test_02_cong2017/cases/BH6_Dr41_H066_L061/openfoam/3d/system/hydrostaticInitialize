hydrostaticInitialize
{
    type            coded;
    libs            (utilityFunctionObjects);
    name            bh6HydrostaticInitializer;

    codeInclude
    #{
        #include "fvCFD.H"
        #include "constrainPressure.H"
        #include "interfaceProperties.H"
        #include "PstreamReduceOps.H"
    #};

    codeOptions
    #{
        -I$(LIB_SRC)/transportModels/interfaceProperties/lnInclude
    #};

    codeLibs
    #{
        -linterfaceProperties
    #};

    codeExecute
    #{
        volScalarField pressure
        (
            IOobject
            (
                "p",
                mesh().time().timeName(),
                mesh(),
                IOobject::MUST_READ,
                IOobject::AUTO_WRITE
            ),
            mesh()
        );
        volScalarField reducedPressure
        (
            IOobject
            (
                "p_rgh",
                mesh().time().timeName(),
                mesh(),
                IOobject::MUST_READ,
                IOobject::AUTO_WRITE
            ),
            mesh()
        );
        const volScalarField alpha
        (
            IOobject
            (
                "alpha.water",
                mesh().time().timeName(),
                mesh(),
                IOobject::MUST_READ,
                IOobject::NO_WRITE
            ),
            mesh()
        );
        const volScalarField temperatureField
        (
            IOobject
            (
                "T",
                mesh().time().timeName(),
                mesh(),
                IOobject::MUST_READ,
                IOobject::NO_WRITE
            ),
            mesh()
        );
        const volVectorField velocity
        (
            IOobject
            (
                "U",
                mesh().time().timeName(),
                mesh(),
                IOobject::MUST_READ,
                IOobject::NO_WRITE
            ),
            mesh()
        );
        volScalarField density
        (
            IOobject
            (
                "rho",
                mesh().time().timeName(),
                mesh(),
                IOobject::NO_READ,
                IOobject::NO_WRITE
            ),
            mesh(),
            dimensionedScalar("rho", dimDensity, 0.0)
        );
        const scalar atmosphericPressure = 101325.0;
        const scalar waterDensity = 998.0;
        const scalar waterReducedPressure = 107541.3913;
        const scalar gravityZ = -9.81;
        const scalar Rair = 8314.46261815324/28.965;
        const vectorField& centres = mesh().C();
        forAll(pressure, cellI)
        {
            const scalar aw = min(max(alpha[cellI], 0.0), 1.0);
            const scalar rhoAir =
                atmosphericPressure
               /(Rair*max(temperatureField[cellI], 1.0));
            const scalar rhoMixture =
                aw*waterDensity + (1.0 - aw)*rhoAir;
            const scalar pAbs =
                aw > 0.5
              ? waterReducedPressure
                + waterDensity*gravityZ*centres[cellI].z()
              : atmosphericPressure;

            pressure[cellI] = pAbs;
            density[cellI] = rhoMixture;
            reducedPressure[cellI] =
                pAbs - rhoMixture*gravityZ*centres[cellI].z();
        }

        forAll(mesh().boundary(), patchI)
        {
            fvPatchScalarField& pressurePatch =
                pressure.boundaryFieldRef()[patchI];
            fvPatchScalarField& reducedPressurePatch =
                reducedPressure.boundaryFieldRef()[patchI];
            fvPatchScalarField& densityPatch =
                density.boundaryFieldRef()[patchI];
            const fvPatch& patch = mesh().boundary()[patchI];
            const labelUList& faceCells = patch.faceCells();
            const vectorField& faceCentres = patch.Cf();

            forAll(pressurePatch, faceI)
            {
                const label cellI = faceCells[faceI];
                const scalar aw = min(max(alpha[cellI], 0.0), 1.0);
                const scalar rhoAir =
                    atmosphericPressure
                   /(Rair*max(temperatureField[cellI], 1.0));
                const scalar rhoMixture =
                    aw*waterDensity + (1.0 - aw)*rhoAir;
                const scalar pAbs =
                    aw > 0.5
                  ? waterReducedPressure
                    + waterDensity*gravityZ*faceCentres[faceI].z()
                  : atmosphericPressure;

                pressurePatch[faceI] = pAbs;
                densityPatch[faceI] = rhoMixture;
                reducedPressurePatch[faceI] =
                    pAbs - rhoMixture*gravityZ*faceCentres[faceI].z();
            }
        }

        const dimensionedVector gravity
        (
            "g",
            dimAcceleration,
            vector(0.0, 0.0, gravityZ)
        );
        const uniformDimensionedScalarField hRef
        (
            IOobject
            (
                "hRef",
                mesh().time().constant(),
                mesh(),
                IOobject::READ_IF_PRESENT,
                IOobject::NO_WRITE
            ),
            dimensionedScalar(word::null, dimLength, Zero)
        );
        const volScalarField gh
        (
            IOobject
            (
                "ghHydrostatic",
                mesh().time().timeName(),
                mesh(),
                IOobject::NO_READ,
                IOobject::NO_WRITE
            ),
            gravity & mesh().C()
        );
        const surfaceScalarField ghf
        (
            IOobject
            (
                "ghfHydrostatic",
                mesh().time().timeName(),
                mesh(),
                IOobject::NO_READ,
                IOobject::NO_WRITE
            ),
            gravity & mesh().Cf()
        );
        const surfaceScalarField rAUf
        (
            IOobject
            (
                "rAUfHydrostatic",
                mesh().time().timeName(),
                mesh(),
                IOobject::NO_READ,
                IOobject::NO_WRITE
            ),
            mesh(),
            dimensionedScalar("rAUf", dimTime/dimDensity, 1.0)
        );
        const IOdictionary transportProperties
        (
            IOobject
            (
                "thermophysicalProperties",
                mesh().time().constant(),
                mesh(),
                IOobject::MUST_READ,
                IOobject::NO_WRITE
            )
        );
        interfaceProperties interface
        (
            alpha,
            velocity,
            transportProperties
        );
        const surfaceScalarField bodyForceFlux
        (
            IOobject
            (
                "bodyForceFluxHydrostatic",
                mesh().time().timeName(),
                mesh(),
                IOobject::NO_READ,
                IOobject::NO_WRITE
            ),
            (
                interface.surfaceTensionForce()
              - ghf*fvc::snGrad(density)
            )*rAUf*mesh().magSf()
        );

        constrainPressure
        (
            reducedPressure,
            velocity,
            bodyForceFlux,
            rAUf
        );

        label downstreamReferenceCell = -1;
        scalar downstreamReferenceDistanceSqr = GREAT;
        const vector downstreamReferencePoint(6.30, 0.0, 0.0);
        forAll(centres, cellI)
        {
            if (centres[cellI].x() > 5.98 && alpha[cellI] < 0.5)
            {
                const scalar distanceSqr = magSqr
                (
                    centres[cellI] - downstreamReferencePoint
                );
                if (distanceSqr < downstreamReferenceDistanceSqr)
                {
                    downstreamReferenceDistanceSqr = distanceSqr;
                    downstreamReferenceCell = cellI;
                }
            }
        }
        if (downstreamReferenceCell < 0)
        {
            FatalErrorInFunction
                << "Unable to select the isolated downstream-air reference cell"
                << exit(FatalError);
        }
        const scalar downstreamReferencePressure =
            atmosphericPressure
          - density[downstreamReferenceCell]
           *gravityZ*centres[downstreamReferenceCell].z();

        for (label corrector = 0; corrector < 4; ++corrector)
        {
            fvScalarMatrix reducedPressureEqn
            (
                fvc::div(bodyForceFlux)
              - fvm::laplacian(rAUf, reducedPressure)
            );
            reducedPressureEqn.setReference
            (
                downstreamReferenceCell,
                downstreamReferencePressure,
                true
            );
            reducedPressureEqn.solve();
        }

        pressure = max
        (
            reducedPressure + density*gh,
            dimensionedScalar("pMin", dimPressure, 50000.0)
        );
        pressure.correctBoundaryConditions();
        pressure.write();
        reducedPressure.write();

        const scalarField& volumes = mesh().V();
        scalar waterVolume = 0.0;
        scalar waterMass = 0.0;
        scalar airVolume = 0.0;
        scalar airMass = 0.0;
        scalar apparatusAirVolume = 0.0;
        scalar apparatusAirMass = 0.0;
        scalar downstreamAirVolume = 0.0;
        scalar downstreamAirMass = 0.0;
        scalar externalWaterVolume = 0.0;
        scalar minPressure = GREAT;
        scalar maxPressure = -GREAT;
        forAll(volumes, cellI)
        {
            const scalar aw = min(max(alpha[cellI], 0.0), 1.0);
            const scalar aa = 1.0 - aw;
            const scalar cellVolume = volumes[cellI];
            const scalar pAbs = max(pressure[cellI], 1.0);
            const scalar rhoAir =
                pAbs/(Rair*max(temperatureField[cellI], 1.0));

            waterVolume += aw*cellVolume;
            waterMass += aw*998.0*cellVolume;
            airVolume += aa*cellVolume;
            airMass += aa*rhoAir*cellVolume;
            if (centres[cellI].z() < 1.825)
            {
                apparatusAirVolume += aa*cellVolume;
                apparatusAirMass += aa*rhoAir*cellVolume;
            }
            if
            (
                centres[cellI].x() >= 5.98
             && mag(centres[cellI].y()) <= 0.025
             && mag(centres[cellI].z()) <= 0.025
            )
            {
                downstreamAirVolume += aa*cellVolume;
                downstreamAirMass += aa*rhoAir*cellVolume;
            }
            if (centres[cellI].z() > 1.825)
            {
                externalWaterVolume += aw*cellVolume;
            }
            minPressure = min(minPressure, pressure[cellI]);
            maxPressure = max(maxPressure, pressure[cellI]);
        }

        reduce(waterVolume, sumOp<scalar>());
        reduce(waterMass, sumOp<scalar>());
        reduce(airVolume, sumOp<scalar>());
        reduce(airMass, sumOp<scalar>());
        reduce(apparatusAirVolume, sumOp<scalar>());
        reduce(apparatusAirMass, sumOp<scalar>());
        reduce(downstreamAirVolume, sumOp<scalar>());
        reduce(downstreamAirMass, sumOp<scalar>());
        reduce(externalWaterVolume, sumOp<scalar>());
        reduce(minPressure, minOp<scalar>());
        reduce(maxPressure, maxOp<scalar>());

        if (Pstream::master())
        {
            Info.stream().precision(12);
            Info<< "BH6_INITIAL_AUDIT "
                << mesh().time().value() << ' '
                << waterVolume << ' '
                << waterMass << ' '
                << airVolume << ' '
                << airMass << ' '
                << apparatusAirVolume << ' '
                << apparatusAirMass << ' '
                << downstreamAirVolume << ' '
                << downstreamAirMass << ' '
                << externalWaterVolume << ' '
                << minPressure << ' '
                << maxPressure << nl;
        }
        Info<< "BH6_HYDROSTATIC_P_INITIALIZED" << nl;
    #};
}
