#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

ACTION="${1:-prepare}"
RUN_ID="paper_tau0p2_areaeq"
CASE_ROOT="$PWD"
SCRATCH_ROOT="${BH6_2D_SCRATCH:-/tmp/bh6-2d-study}"
RUN_DIR="$SCRATCH_ROOT/$RUN_ID"

OF_ROOT="/usr/lib/openfoam/openfoam2512"
OF_PLATFORM="${OF_ROOT}/platforms/linux64GccDPInt32Opt"
export WM_PROJECT_DIR="$OF_ROOT"
export WM_PROJECT_VERSION=v2512
export FOAM_API=2512
export FOAM_APPBIN="${OF_PLATFORM}/bin"
export FOAM_LIBBIN="${OF_PLATFORM}/lib"
export PATH="${FOAM_APPBIN}:${OF_ROOT}/bin:/usr/bin:/bin"
export LD_LIBRARY_PATH="${FOAM_LIBBIN}:${FOAM_LIBBIN}/sys-openmpi:${FOAM_LIBBIN}/dummy:/usr/lib/x86_64-linux-gnu/openmpi/lib"
export FOAM_USER_APPBIN="${BH6_2D_SOLVER_BIN:-/tmp/bh6-2d-build/bin}"
mkdir -p "$FOAM_USER_APPBIN"
SOLVER="$FOAM_USER_APPBIN/bh6CompressibleInterFoam"

if [[ ! -x "$SOLVER" ]]; then
    bash -lc "source /usr/lib/openfoam/openfoam2512/etc/bashrc >/dev/null 2>&1 && \
        export FOAM_USER_APPBIN='$FOAM_USER_APPBIN' && \
        cd '$CASE_ROOT/solver' && wmake"
fi

for command_name in blockMesh checkMesh topoSet setFields; do
    command -v "$command_name" >/dev/null || {
        echo "Missing OpenFOAM command: $command_name" >&2
        exit 1
    }
done

prepare_case()
{
    case "$RUN_DIR" in
        "$SCRATCH_ROOT"/paper_tau0p2_areaeq) ;;
        *) echo "Refusing unsafe run directory: $RUN_DIR" >&2; exit 2 ;;
    esac
    rm -rf -- "$RUN_DIR"
    mkdir -p "$RUN_DIR"
    cp -a case/. "$RUN_DIR"/
    python3 make_blockmesh.py \
        --config case_config.json \
        --output "$RUN_DIR/system/blockMeshDict" \
        --stats "$RUN_DIR/mesh_stats.json" \
        > "$RUN_DIR/log.make_blockmesh" 2>&1
    (
        cd "$RUN_DIR"
        blockMesh > log.blockMesh 2>&1
        cp -a 0.orig 0
        setFields > log.setFields 2>&1
        topoSet > log.topoSet 2>&1
        checkMesh > log.checkMesh 2>&1
        checkMesh -allGeometry -allTopology > log.checkMesh.extended 2>&1 || true
    )
    python3 "$CASE_ROOT/audit_case.py" --run-dir "$RUN_DIR" --output "$RUN_DIR/paper_audit.json"
    echo "PREPARED $RUN_DIR"
}

run_parallel()
{
    local end_time="$1"
    local log_name="$2"
    local np="${OPENFOAM_NP:-$(nproc)}"
    if (( np > 6 )); then np=6; fi
    if (( np < 1 )); then np=1; fi
    (
        cd "$RUN_DIR"
        foamDictionary system/controlDict -entry endTime -set "$end_time" >/dev/null
        if (( np == 1 )); then
            echo "serial run: decomposition not used" > log.decomposePar
            "$SOLVER" > "$log_name" 2>&1
        else
            foamDictionary system/decomposeParDict -entry numberOfSubdomains -set "$np" >/dev/null
            foamDictionary system/decomposeParDict -entry simpleCoeffs/n -set "($np 1 1)" >/dev/null
            decomposePar -force > log.decomposePar 2>&1
            OMPI_ALLOW_RUN_AS_ROOT=1 \
            OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1 \
            mpirun --oversubscribe -np "$np" "$SOLVER" -parallel \
                > "$log_name" 2>&1
        fi
    )
}

resume_existing_parallel()
{
    local end_time="$1"
    local log_name="$2"
    local np="${OPENFOAM_NP:-2}"
    local existing
    existing="$(find "$RUN_DIR" -maxdepth 1 -type d -name 'processor*' | wc -l)"
    if (( existing < 2 )); then
        echo "No resumable parallel decomposition in $RUN_DIR" >&2
        exit 3
    fi
    if (( np != existing )); then
        echo "OPENFOAM_NP=$np does not match the $existing preserved processor directories" >&2
        exit 4
    fi
    (
        cd "$RUN_DIR"
        foamDictionary system/controlDict -entry startFrom -set latestTime >/dev/null
        foamDictionary system/controlDict -entry endTime -set "$end_time" >/dev/null
        OMPI_ALLOW_RUN_AS_ROOT=1 \
        OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1 \
        mpirun --oversubscribe -np "$np" "$SOLVER" -parallel \
            > "$log_name" 2>&1
    )
}

case "$ACTION" in
    prepare)
        prepare_case
        ;;
    smoke)
        prepare_case
        (
            cd "$RUN_DIR"
            foamDictionary system/controlDict -entry endTime -set 0.01 >/dev/null
            "$SOLVER" > log.smoke 2>&1
        )
        echo "SMOKE_OK $RUN_DIR"
        ;;
    solve)
        prepare_case
        run_parallel "${BH6_END_TIME:-13}" log.solve
        python3 "$CASE_ROOT/postprocess.py" --run-dir "$RUN_DIR" --output-dir "$CASE_ROOT/results"
        if [[ -f "$CASE_ROOT/compare_1d_2d.py" ]]; then
            python3 "$CASE_ROOT/compare_1d_2d.py" --results-dir "$CASE_ROOT/results"
        fi
        mkdir -p "$CASE_ROOT/results/run_record"
        cp -a "$RUN_DIR"/paper_audit.json "$RUN_DIR"/mesh_stats.json \
            "$RUN_DIR"/log.blockMesh "$RUN_DIR"/log.checkMesh \
            "$RUN_DIR"/log.checkMesh.extended \
            "$RUN_DIR"/log.decomposePar "$RUN_DIR"/log.solve \
            "$CASE_ROOT/results/run_record"/
        echo "SOLVE_DONE $RUN_DIR"
        ;;
    resume)
        [[ -d "$RUN_DIR" ]] || { echo "Missing $RUN_DIR" >&2; exit 1; }
        (
            cd "$RUN_DIR"
            foamDictionary system/controlDict -entry startFrom -set latestTime >/dev/null
        )
        run_parallel 13 log.solve.resume
        python3 "$CASE_ROOT/postprocess.py" --run-dir "$RUN_DIR" --output-dir "$CASE_ROOT/results"
        if [[ -f "$CASE_ROOT/compare_1d_2d.py" ]]; then
            python3 "$CASE_ROOT/compare_1d_2d.py" --results-dir "$CASE_ROOT/results"
        fi
        ;;
    resume-complete)
        [[ -d "$RUN_DIR" ]] || { echo "Missing $RUN_DIR" >&2; exit 1; }
        complete_end="${BH6_COMPLETE_END_TIME:-20}"
        complete_tag="${complete_end//./p}"
        complete_log="log.solve.complete${complete_tag}"
        complete_root="$CASE_ROOT/complete_event/end${complete_tag}"
        resume_existing_parallel "$complete_end" "$complete_log"
        python3 "$CASE_ROOT/postprocess.py" \
            --run-dir "$RUN_DIR" --output-dir "$complete_root/results"
        if [[ -f "$CASE_ROOT/compare_1d_2d.py" ]]; then
            python3 "$CASE_ROOT/compare_1d_2d.py" \
                --results-dir "$complete_root/results"
        fi
        mkdir -p "$complete_root/run_record"
        cp -a "$RUN_DIR"/paper_audit.json "$RUN_DIR"/mesh_stats.json \
            "$RUN_DIR"/log.blockMesh "$RUN_DIR"/log.checkMesh \
            "$RUN_DIR"/log.checkMesh.extended "$RUN_DIR"/log.decomposePar \
            "$RUN_DIR"/log.solve "$RUN_DIR/$complete_log" \
            "$complete_root/run_record"/
        echo "COMPLETE_EVENT_DONE $RUN_DIR -> $complete_root"
        ;;
    post)
        python3 "$CASE_ROOT/postprocess.py" --run-dir "$RUN_DIR" --output-dir "$CASE_ROOT/results"
        if [[ -f "$CASE_ROOT/compare_1d_2d.py" ]]; then
            python3 "$CASE_ROOT/compare_1d_2d.py" --results-dir "$CASE_ROOT/results"
        fi
        ;;
    *)
        echo "Usage: ./Allrun prepare|smoke|solve|resume|resume-complete|post" >&2
        exit 2
        ;;
esac
