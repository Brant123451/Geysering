#!/bin/bash
cd "$(dirname "$0")"

if [[ -f /usr/lib/openfoam/openfoam2512/etc/bashrc ]]; then
    source /usr/lib/openfoam/openfoam2512/etc/bashrc
fi
set -euo pipefail

foamListTimes -rm 2>/dev/null || true

rm -rf \
    0 \
    processor* \
    constant/polyMesh \
    postProcessing \
    badFacesVTK \
    core \
    bh4-3d.msh \
    bh4-*.stl \
    mesh_metadata.json \
    featureFaces.obj \
    featureEdges.obj \
    singleCellFeaturePoints.obj \
    multiCellFeaturePoints.obj \
    log.* \
    system/meshDict \
    system/decomposeParDict.runtime \
    system/riserProbeLocations \
    system/horizontalProbeLocations

python3 configure_valve.py --opening-time 0.20 >/dev/null
printf 'endTime 13.0;\n' > system/endTime.inc
printf 'maxDeltaT 0.0005;\n' > system/maxDeltaT.inc
echo "B-H4 generated OpenFOAM files removed"
