FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setExprFieldsDict;
}

expressions
(
    hydrostaticAbsolutePressure
    {
        field       p;
        dimensions  [1 -1 -2 0 0 0 0];
        expression
        #{
            alpha.water
           *(101325 + 998*9.81*(0.660 - pos().z()))
          + (1 - alpha.water)*101325
        #};
    }

    hydrostaticReducedPressure
    {
        field       p_rgh;
        dimensions  [1 -1 -2 0 0 0 0];
        expression
        #{
            alpha.water*107786.6508
          + (1 - alpha.water)
           *(101325 + 1.191920596*9.81*pos().z())
        #};
    }
);
