FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}

numberOfSubdomains 4;
method              scotch;

constraints
{
    baffles
    {
        type        preserveBaffles;
        enabled     true;
    }
    faceZones
    {
        type        preserveFaceZones;
        zones       (".*");
        enabled     true;
    }
}
