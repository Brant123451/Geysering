    boxToCell
    {
        box (-1 0.66 -1) (10 4.0 1);
        fieldValues
        (
            volScalarFieldValue alpha.water 0
            volScalarFieldValue p_rgh 101325.0
            volScalarFieldValue p 101325.0
        );
    }

    // full-bore air pocket downstream of release plane (paper L0)
    boxToCell
    {
        box (5.98 -1 -1) (10 4.0 1);
        fieldValues
        (
            volScalarFieldValue alpha.water 0
            volScalarFieldValue p_rgh 101325.0
            volScalarFieldValue p 101325.0
        );
    }
);
