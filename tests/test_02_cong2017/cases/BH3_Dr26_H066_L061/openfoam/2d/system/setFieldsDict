    object      setFieldsDict;
}

defaultFieldValues
(
    volScalarFieldValue alpha.water 1
    volScalarFieldValue p_rgh 107786.651
    volScalarFieldValue p 107786.651
    volScalarFieldValue T 296.15
);

regions
(
