FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object thermophysicalProperties;
}
thermoType
{
    type heRhoThermo;
    mixture pureMixture;
    transport const;
    thermo hConst;
    equationOfState perfectFluid;
    specie specie;
    energy sensibleEnthalpy;
}
mixture
{
    specie
    {
        molWeight 18.01528;
    }
    equationOfState
    {
        // rho(101325 Pa, 296.15 K)=998 kg/m3 and bulk modulus=2.2 GPa.
        R 7443.554670851;
        rho0 997.953955;
    }
    thermodynamics
    {
        Cp 4182;
        Hf 0;
    }
    transport
    {
        mu 1.003e-3;
        Pr 7.0;
    }
}

