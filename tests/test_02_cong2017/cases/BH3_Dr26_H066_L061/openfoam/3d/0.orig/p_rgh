FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}

dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 107786.651;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 107786.651;
    }
    closedEnd
    {
        type            fixedFluxPressure;
        value           uniform 101325;
    }
    walls
    {
        type            fixedFluxPressure;
        value           uniform 107786.651;
    }
    riserWall
    {
        type            fixedFluxPressure;
        value           uniform 107786.651;
    }
    atmosphere
    {
        // Isothermal hydrostatic ambient pressure, referenced to 101325 Pa
        // at the initial free-surface elevation.  A height-independent p0
        // would put the external air column into gravitational free fall.
        type            exprFixedValue;
        valueExpr       "101325*exp(-9.81*(pos().z()-0.66)/(287.0421396863*296.15))*(1+9.81*pos().z()/(287.0421396863*296.15))";
        value           uniform 101325;
    }
}
