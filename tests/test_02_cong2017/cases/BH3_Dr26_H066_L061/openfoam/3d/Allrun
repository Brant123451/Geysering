#!/bin/bash
cd "$(dirname "$0")" || exit 1

source /usr/lib/openfoam/openfoam2512/etc/bashrc
set -euo pipefail

RUN_MODE="${RUN_MODE:-event}"
VALVE_OPENING="${VALVE_OPENING:-instant}"
END_TIME="${END_TIME:-13}"
RUN_ID="${RUN_ID:-${RUN_MODE}_${VALVE_OPENING}}"
NP="${OPENFOAM_NP:-4}"
INITIAL_INTERFACE_THICKNESS="${INITIAL_INTERFACE_THICKNESS:-0.015}"

if [[ "$RUN_MODE" != "event" && "$RUN_MODE" != "closed" ]]; then
    echo "RUN_MODE must be event or closed" >&2
    exit 2
fi
if [[ "$RUN_MODE" == "event" ]]; then
    case "$VALVE_OPENING" in
        instant|0.2|0.5) ;;
        *)
            echo "VALVE_OPENING must be instant, 0.2, or 0.5" >&2
            exit 2
            ;;
    esac
else
    VALVE_OPENING=closed
fi
if (( NP < 1 )); then
    echo "OPENFOAM_NP must be positive" >&2
    exit 2
fi

if [[ ! -d constant/polyMesh ]]; then
    ./Allmesh
fi
if [[ -d 0 || -d processor0 ]]; then
    echo "Existing initial/decomposed solution detected; use a clean runtime copy." >&2
    exit 1
fi

python3 make_runtime_config.py \
    --end-time "$END_TIME" \
    --initial-delta-t "${INITIAL_DELTA_T:-1e-6}" \
    --max-co "${MAX_CO:-0.25}" \
    --max-alpha-co "${MAX_ALPHA_CO:-0.15}" \
    --max-delta-t "${MAX_DELTA_T:-0.0005}" \
    --c-alpha "${C_ALPHA:-1.0}" \
    --alpha-smooth-curvature "${ALPHA_SMOOTH_CURVATURE:-0}" \
    --sample-interval "${SAMPLE_INTERVAL:-0.005}" \
    --write-interval "${WRITE_INTERVAL:-0.05}" \
    --surface-tension "${SURFACE_TENSION:-0.072}" \
    > log.runtimeConfig 2>&1

cp -a 0.orig 0
setFields > log.setFields 2>&1

# The experimental interface is sharp.  The paired-CFD-style sharp profile and
# the declared three-base-cell diffuse profile are kept as explicit controls.
case "$INITIAL_INTERFACE_THICKNESS" in
    0|0.0|0.000)
        PHASE_EXPRESSION="(pos().x()>=5.98 ? 0 : (pos().z()<=0.66 ? 1 : 0))"
        PHASE_BOUNDARY_DICT="system/setExprBoundaryFieldsDict.sharp"
        ;;
    0.015|.015)
        PHASE_EXPRESSION="(pos().x()>=5.98 ? 0 : (pos().z()<=0.6525 ? 1 : (pos().z()>=0.6675 ? 0 : (0.6675-pos().z())/0.015)))"
        PHASE_BOUNDARY_DICT="system/setExprBoundaryFieldsDict"
        ;;
    *)
        echo "INITIAL_INTERFACE_THICKNESS must be 0 or 0.015 m" >&2
        exit 2
        ;;
esac
setExprFields -time 0 \
    -field alpha.water \
    -expression "$PHASE_EXPRESSION" \
    -keepPatches \
    > log.initializePhase 2>&1

# Phase-specific isothermal hydrostatic profiles for the two equations of state.
# The open air column is referenced to atmospheric pressure at H0; the
# initially isolated downstream pocket is referenced at the pipe centreline.
WATER_PRESSURE_EXPR="(101325+997.954035295*7443.55501481*296.15)*exp(9.81*(0.66-pos().z())/(7443.55501481*296.15))-997.954035295*7443.55501481*296.15"
OPEN_AIR_PRESSURE_EXPR="101325*exp(-9.81*(pos().z()-0.66)/(287.0421396863*296.15))"
POCKET_AIR_PRESSURE_EXPR="101325*exp(-9.81*(pos().z()-0.025)/(287.0421396863*296.15))"
AIR_PRESSURE_EXPR="(pos().x()>=5.98 ? ${POCKET_AIR_PRESSURE_EXPR} : ${OPEN_AIR_PRESSURE_EXPR})"

setExprFields -time 0 \
    -field p \
    -expression "alpha.water*(${WATER_PRESSURE_EXPR})+(1-alpha.water)*(${AIR_PRESSURE_EXPR})" \
    -load-fields "(alpha.water)" \
    -keepPatches \
    > log.initializeHydrostaticP 2>&1
setExprFields -time 0 \
    -field p_rgh \
    -expression "p+(alpha.water*(997.954035295+p/(7443.55501481*296.15))+(1-alpha.water)*p/(287.0421396863*296.15))*9.81*pos().z()" \
    -load-fields "(alpha.water p)" \
    -keepPatches \
    > log.initializeHydrostaticPrgh 2>&1
setExprBoundaryFields -time 0 -dict "$PHASE_BOUNDARY_DICT" \
    > log.initializeBoundaryFields 2>&1
postProcess \
    -dict system/initialVolumeAuditDict \
    -time 0 \
    -fields "(alpha.water)" \
    > log.initialVolumeAudit 2>&1
topoSet -dict system/topoSetDict.valve > log.topoSet.valve 2>&1
python3 make_valve_dict.py \
    --mode "$VALVE_OPENING" \
    --output system/createBafflesDict.runtime \
    > log.valveDict 2>&1
createBaffles -overwrite -dict system/createBafflesDict.runtime \
    > log.createBaffles 2>&1
checkMesh -allGeometry -allTopology > log.checkMesh.baffled 2>&1
python3 mesh_audit.py \
    --profile "${MESH_PROFILE:-base}-${VALVE_OPENING}" \
    --check-mesh-log log.checkMesh.baffled \
    --output "outputs/${RUN_ID}_mesh.json" \
    > log.meshAudit.baffled 2>&1

if [[ "$RUN_MODE" == "closed" ]]; then
    bash ./Allwmake > log.wmake.balanceInitialPressure 2>&1
    balanceInitialPressure -time 0 \
        > log.balanceInitialPressure 2>&1
fi

if (( NP == 1 )); then
    compressibleInterFoam > log.compressibleInterFoam 2>&1
else
    cp system/decomposeParDict system/decomposeParDict.runtime
    foamDictionary system/decomposeParDict.runtime \
        -entry numberOfSubdomains -set "$NP" >/dev/null
    decomposePar -decomposeParDict system/decomposeParDict.runtime \
        > log.decomposePar 2>&1
    OMPI_ALLOW_RUN_AS_ROOT=1 \
    OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1 \
        mpirun -np "$NP" compressibleInterFoam -parallel \
        > log.compressibleInterFoam 2>&1
fi

python3 postprocess.py \
    --case . \
    --reference-root "${REFERENCE_ROOT:-../..}" \
    --run-id "$RUN_ID" \
    --run-mode "$RUN_MODE" \
    --valve-opening "$VALVE_OPENING" \
    --output outputs

echo "BH3_RUN_DONE id=$RUN_ID mode=$RUN_MODE valve=$VALVE_OPENING"
