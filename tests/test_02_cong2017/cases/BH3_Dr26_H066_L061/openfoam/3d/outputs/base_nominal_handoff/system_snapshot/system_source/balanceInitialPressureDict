FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      balanceInitialPressureDict;
}

nOuterCorrectors           40;
nEosCorrectors             8;
nNonOrthogonalCorrectors   2;

pTolerance                 1e-5;
rhoTolerance               1e-10;
relaxation                 1;
zeroVelocityTolerance      1e-12;
atmosphereGamma            1.4;

// Diagnostic acceptance threshold for the pressure-projectable force
// residual. Diagnostics continue so that the ensuing velocity can be
// measured; production release remains controlled by the 1 s hold gate.
reconstructedResidualTolerance 300;
failOnResidual             false;
