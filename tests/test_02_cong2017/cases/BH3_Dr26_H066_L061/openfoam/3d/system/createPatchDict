FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}

pointSync false;

patches
(
    {
        name inlet;
        patchInfo { type patch; }
        constructFrom patches;
        patches (inlet);
    }
    {
        name closedEnd;
        patchInfo { type wall; }
        constructFrom patches;
        patches (closedEnd);
    }
    {
        name walls;
        patchInfo { type wall; }
        constructFrom patches;
        patches (walls);
    }
    {
        name riserWall;
        patchInfo { type wall; }
        constructFrom patches;
        patches (riserWall);
    }
    {
        name atmosphere;
        patchInfo { type patch; }
        constructFrom patches;
        patches (atmosphere);
    }
);
