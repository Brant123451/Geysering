FoamFile
{
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
dimensions      [0 2 -3 0 0 0 0];
internalField   uniform 3.3e-5;

boundaryField
{
    "(inlet|atmosphere)"
    {
        type            inletOutlet;
        inletValue      uniform 3.3e-5;
        value           uniform 3.3e-5;
    }
    "(walls|downstreamCap|valveWall.*)"
    {
        type            epsilonWallFunction;
        value           uniform 3.3e-5;
    }
    "valveCouple.*"
    {
        type            cyclicACMI;
    }
}
