FoamFile
{
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 107541.8913;

boundaryField
{
    inlet
    {
        type            totalPressure;
        p0              uniform 107541.8913;
        value           uniform 107541.8913;
    }
    atmosphere
    {
        type            prghTotalPressure;
        p0              uniform 101325;
        value           uniform 101325;
    }
    "(walls|downstreamCap|valveWall.*)"
    {
        type            fixedFluxPressure;
        value           uniform 107541.8913;
    }
    "valveCouple.*"
    {
        type            cyclicACMI;
    }
}
