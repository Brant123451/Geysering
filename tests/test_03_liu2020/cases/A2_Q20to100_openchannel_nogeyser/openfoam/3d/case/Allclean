#!/usr/bin/env bash
# Remove all generated OpenFOAM state; retain only compact source geometry.
set -euo pipefail
cd "$(dirname "$0")"

OF_LAUNCH="${OPENFOAM_LAUNCH:-/usr/bin/openfoam2512}"
if [[ -x "$OF_LAUNCH" ]]; then
    "$OF_LAUNCH" -- foamListTimes -rm >/dev/null 2>&1 || true
fi
rm -rf -- -8 -4 0 processor* postProcessing constant/polyMesh
rm -f log.* mesh.profile system/riserProbeLocations system/tankProbeLocations
rm -f system/boreProbeLocations
rm -f constant/triSurface/geometry.stl
rm -rf ../__pycache__ ../../../model/__pycache__
echo "CLEAN_DONE"
