FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 5;

boundaryField
{
    inlet
    {
        type            turbulentMixingLengthFrequencyInlet;
        mixingLength    0.02;
        value           uniform 5;
    }
    tankAtmosphere
    {
        type            inletOutlet;
        inletValue      uniform 5;
        value           uniform 5;
    }
    riserOutlet
    {
        type            inletOutlet;
        inletValue      uniform 5;
        value           uniform 5;
    }
    weirOutlet
    {
        type            inletOutlet;
        inletValue      uniform 5;
        value           uniform 5;
    }
    solidWalls
    {
        type            omegaWallFunction;
        value           uniform 5;
    }
    solidRiserWall
    {
        type            omegaWallFunction;
        value           uniform 5;
    }
}