FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    outlet
    {
        type            prghTotalPressure;
        p0              uniform 0;
        value           uniform 0;
    }
    outletWater
    {
        // Fixed-stage equivalent: p_rgh=rho_w*g*hd, hd=0.070 m.
        // The downstream tank/weir dimensions and rating are not reported.
        type            fixedValue;
        value           uniform 686.7;
    }
    headboxAtmosphere
    {
        type            prghTotalPressure;
        p0              uniform 0;
        value           uniform 0;
    }
    riserOutlet
    {
        type            prghTotalPressure;
        p0              uniform 0;
        value           uniform 0;
    }
    solidWalls
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    solidRiserWall
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
}