FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        // Reported Q0/Q1.  Task time origin: ramp begins at t=0.
        // The paper instead defines t=0 at fully-open valve (audit documents
        // this 0.4 s shift).  Negative time is the Q0 stabilization run.
        type            flowRateInletVelocity;
        volumetricFlowRate table
        (
            (-4.0  0.020)
            ( 0.0  0.020)
            ( 0.4  0.100)
            (14.4  0.100)
        );
        value           uniform (0 0 0);
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    outletWater
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    headboxAtmosphere
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    riserOutlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    solidWalls
    {
        type            noSlip;
    }
    solidRiserWall
    {
        type            noSlip;
    }
}