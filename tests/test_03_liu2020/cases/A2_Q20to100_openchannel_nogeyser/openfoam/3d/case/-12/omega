FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "-12";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 5;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 9.53;
    }
    riserOutlet
    {
        type            inletOutlet;
        inletValue      uniform 5;
        value           uniform 5;
    }
    tankAtmosphere
    {
        type            inletOutlet;
        inletValue      uniform 5;
        value           uniform 5;
    }
    weirOutlet
    {
        type            inletOutlet;
        inletValue      uniform 5;
        value           uniform 5;
    }
    solidWalls
    {
        type            omegaWallFunction;
        value           uniform 5;
    }
    solidRiserWall
    {
        type            omegaWallFunction;
        value           uniform 5;
    }
}


