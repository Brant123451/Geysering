FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}

// Split the circular end face at the reported initial tailwater elevation
// hd = Dd/4 = 0.070 m.  Face-centre selection makes the split converge with
// boundary refinement without inventing the unreported tank/weir geometry.
actions
(
    {
        name        outletWaterFaces;
        type        faceSet;
        action      new;
        source      patchToFace;
        patch       outlet;
    }
    {
        name        outletWaterFaces;
        type        faceSet;
        action      subset;
        source      boxToFace;
        sourceInfo
        {
            box     (6.249 -1 -1) (6.251 1 0.070);
        }
    }
);
