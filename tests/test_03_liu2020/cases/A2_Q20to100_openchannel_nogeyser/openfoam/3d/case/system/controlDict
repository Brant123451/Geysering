/*--------------------------------*- C++ -*----------------------------------*\
| Liu2020 A2: full 3-D interFoam validation                                  |
| t=-4..0 s Q0 stabilization; t=0..0.4 s Q0->Q1; end t=14.4 s               |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     interFoam;
startFrom       startTime;
startTime       -4;
stopAt          endTime;
endTime         14.4;
deltaT          0.0001;

writeControl    adjustableRunTime;
writeInterval   1.0;
purgeWrite      3;
writeFormat     binary;
writePrecision  7;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable yes;

adjustTimeStep  yes;
maxCo           0.47;
maxAlphaCo      0.35;
maxDeltaT       0.002;

functions
{
    // Order is PT1, PT2, PT3.  The paper gives elevation/wall but not the
    // in-plane or circumferential coordinates; those choices are documented.
    probesPT
    {
        type            probes;
        libs            (sampling);
        writeControl    timeStep;
        writeInterval   5;
        fields          (p p_rgh alpha.water);
        probeLocations
        (
            (0.15  0.025 1.25)
            (0.08  0.080 0.445)
            (0.15 -0.145 0.020)
        );
    }

    // 61 levels x 5 radial samples; generated deterministically before solve.
    riserAlpha
    {
        type            probes;
        libs            (sampling);
        writeControl    timeStep;
        writeInterval   10;
        fields          (alpha.water);
        probeLocations
        (
            #include "riserProbeLocations"
        );
    }

    chamberLevel
    {
        type            probes;
        libs            (sampling);
        writeControl    timeStep;
        writeInterval   10;
        fields          (alpha.water);
        probeLocations
        (
            (0.05 0.05 0.02) (0.05 0.05 0.10) (0.05 0.05 0.20)
            (0.05 0.05 0.30) (0.05 0.05 0.44)
            (0.25 0.05 0.02) (0.25 0.05 0.10) (0.25 0.05 0.20)
            (0.25 0.05 0.30) (0.25 0.05 0.44)
        );
    }

    // Interpolate alpha to faces, then integrate phase-weighted boundary
    // fluxes.  Together with waterVolume these give an independent liquid
    // continuity residual.
    alphaWaterFace
    {
        type            surfaceInterpolate;
        libs            (fieldFunctionObjects);
        fields          ((alpha.water alphaWaterFace));
        executeControl  timeStep;
        executeInterval 1;
        writeControl    none;
    }

    waterVolume
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        writeControl    timeStep;
        writeInterval   20;
        log             false;
        writeFields     false;
        regionType      all;
        operation       volIntegrate;
        fields          (alpha.water);
    }

    waterFluxInlet
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        writeControl    timeStep;
        writeInterval   20;
        log             false;
        writeFields     false;
        regionType      patch;
        name            inlet;
        operation       weightedSum;
        weightField     alphaWaterFace;
        fields          (phi);
    }

    waterFluxOutletAir
    {
        $waterFluxInlet;
        name            outlet;
    }

    waterFluxOutletWater
    {
        $waterFluxInlet;
        name            outletWater;
    }

    waterFluxHeadboxAtmosphere
    {
        $waterFluxInlet;
        name            headboxAtmosphere;
    }

    waterFluxRiserOutlet
    {
        $waterFluxInlet;
        name            riserOutlet;
    }
}
