/*--------------------------------*- C++ -*----------------------------------*\
| snappyHexMesh -- castellate + snap (no layers, robustness first)            |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    walls.stl      { type triSurfaceMesh; name walls; }
    riserWall.stl  { type triSurfaceMesh; name riserWall; }
    inlet.stl      { type triSurfaceMesh; name inlet; }
    atmosphere.stl { type triSurfaceMesh; name atmosphere; }
    outlet.stl     { type triSurfaceMesh; name outlet; }

    chamberZone    // junction chamber + both pipe-junction vicinities
    {
        type searchableBox;
        min (-0.30 -0.16  0.00);
        max ( 0.60  0.16  0.50);
    }
    riserZone      // riser interior
    {
        type searchableCylinder;
        point1 (0.15 0.0 0.44);
        point2 (0.15 0.0 1.68);
        radius 0.032;
    }
}

castellatedMeshControls
{
    maxLocalCells       2000000;
    maxGlobalCells      8000000;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 2;

    features
    (
        { file "walls.eMesh";      level 1; }
        { file "riserWall.eMesh";  level 2; }
    );

    refinementSurfaces
    {
        walls      { level (1 1); patchInfo { type wall; } }
        riserWall  { level (2 2); patchInfo { type wall; } }
        inlet      { level (1 1); patchInfo { type patch; } }
        atmosphere { level (1 1); patchInfo { type patch; } }
        outlet     { level (1 1); patchInfo { type patch; } }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        chamberZone { mode inside; levels ((1e15 1)); }
        riserZone   { mode inside; levels ((1e15 2)); }
    }

    locationInMesh (0.15 0.0 0.20);   // inside the junction chamber
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch    3;
    tolerance       2.0;
    nSolveIter      50;
    nRelaxIter      5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes true;
    layers {}
    expansionRatio 1.2;
    finalLayerThickness 0.5;
    minThickness 0.25;
    nGrow 0;
    featureAngle 60;
    slipFeatureAngle 30;
    nRelaxIter 3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
}

meshQualityControls
{
    maxNonOrtho 65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minVol 1e-13;
    minTetQuality 1e-15;
    minArea -1;
    minTwist 0.02;
    minDeterminant 0.001;
    minFaceWeight 0.05;
    minVolRatio 0.01;
    minTriangleTwist -1;
    nSmoothScale 4;
    errorReduction 0.75;
}

writeFlags ();
mergeTolerance 1e-6;
