FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}

// Paper-consistent initial water:
//   upstream depth ~0.08 m (p. 04019055-3);
//   chamber free surface z=0.12 m, inferred from PT3=0.99 kPa at z=0.02 m;
//   downstream depth hd=Dd/4=0.070 m (Table 1).
// Six boxes approximate the upstream 1:100 free surface; the -4..0 s Q0
// stabilization removes this small staircase perturbation before the ramp.

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
    volScalarFieldValue p_rgh 0
    volVectorFieldValue U (0 0 0)
);

regions
(
    // Numerical headbox, matched to the upstream free surface at x=-5.80.
    boxToCell { box (-6.20 -1 -1) (-5.80 1 0.318);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
            volScalarFieldValue p_rgh 3118
            volVectorFieldValue U (0 0 0.190476)
        ); }

    // Upstream pipe: invert z=0.18-0.01*x, depth ~0.08 m.
    boxToCell { box (-5.82 -1 -1) (-4.83 1 0.3132);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
            volScalarFieldValue p_rgh 3072
            volVectorFieldValue U (1.70425 0 -0.0170425)
        ); }
    boxToCell { box (-4.83 -1 -1) (-3.87 1 0.3035);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
            volScalarFieldValue p_rgh 2977
            volVectorFieldValue U (1.70425 0 -0.0170425)
        ); }
    boxToCell { box (-3.87 -1 -1) (-2.90 1 0.2939);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
            volScalarFieldValue p_rgh 2883
            volVectorFieldValue U (1.70425 0 -0.0170425)
        ); }
    boxToCell { box (-2.90 -1 -1) (-1.93 1 0.2842);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
            volScalarFieldValue p_rgh 2788
            volVectorFieldValue U (1.70425 0 -0.0170425)
        ); }
    boxToCell { box (-1.93 -1 -1) (-0.97 1 0.2745);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
            volScalarFieldValue p_rgh 2693
            volVectorFieldValue U (1.70425 0 -0.0170425)
        ); }
    boxToCell { box (-0.97 -1 -1) ( 0.00 1 0.2649);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
            volScalarFieldValue p_rgh 2599
            volVectorFieldValue U (1.70425 0 -0.0170425)
        ); }

    // junction chamber
    boxToCell { box (0.00 -1 -1) (0.30 1 0.12);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
            volScalarFieldValue p_rgh 1177
        ); }

    // downstream pipe (invert z=0), paper target hd/Dd=1/4.
    boxToCell { box (0.30 -1 -1) (6.25 1 0.070);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
            volScalarFieldValue p_rgh 687
            volVectorFieldValue U (1.66140 0 0)
        ); }
);
