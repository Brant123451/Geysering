FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}

// initial water: headbox filled to 0.55 m, upstream pipe near normal depth
// (stepped boxes following the 1:100 slope, invert z = 0.18 - 0.01*x),
// chamber 0.12 m, downstream pipe 0.088 m (weir-controlled tailwater)

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
);

regions
(
    // headbox: start near the entrance-control equilibrium for Q0
    // (pipe invert 0.238 there; specific energy ~1.5*yc above invert)
    boxToCell { box (-6.20 -1 -1) (-5.80 1 0.42);
        fieldValues ( volScalarFieldValue alpha.water 1 ); }

    // upstream pipe, 6 stepped boxes (invert 0.238 -> 0.180, depth ~0.10)
    boxToCell { box (-5.82 -1 -1) (-4.83 1 0.338);
        fieldValues ( volScalarFieldValue alpha.water 1 ); }
    boxToCell { box (-4.83 -1 -1) (-3.87 1 0.328);
        fieldValues ( volScalarFieldValue alpha.water 1 ); }
    boxToCell { box (-3.87 -1 -1) (-2.90 1 0.319);
        fieldValues ( volScalarFieldValue alpha.water 1 ); }
    boxToCell { box (-2.90 -1 -1) (-1.93 1 0.309);
        fieldValues ( volScalarFieldValue alpha.water 1 ); }
    boxToCell { box (-1.93 -1 -1) (-0.97 1 0.299);
        fieldValues ( volScalarFieldValue alpha.water 1 ); }
    boxToCell { box (-0.97 -1 -1) ( 0.00 1 0.290);
        fieldValues ( volScalarFieldValue alpha.water 1 ); }

    // junction chamber
    boxToCell { box (0.00 -1 -1) (0.30 1 0.12);
        fieldValues ( volScalarFieldValue alpha.water 1 ); }

    // downstream pipe (invert z=0)
    boxToCell { box (0.30 -1 -1) (6.25 1 0.088);
        fieldValues ( volScalarFieldValue alpha.water 1 ); }
);
