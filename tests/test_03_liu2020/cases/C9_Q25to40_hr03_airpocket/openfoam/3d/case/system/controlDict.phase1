/* OpenFOAM v2512 source generated by prepare_case.py */
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     compressibleInterFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         6.75;
deltaT          1e-6;
writeControl    adjustableRunTime;
writeInterval   0.25;
purgeWrite      4;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   10;
runTimeModifiable yes;

adjustTimeStep  yes;
maxCo           0.35;
maxAlphaCo      0.2;
maxDeltaT       0.0005;

functions
{
    tracerAirFraction
    {
        // Residual air fraction keeps the compressible scalar matrix
        // non-singular in pure-water cells without transporting tracer there.
        type            exprField;
        libs            (fieldFunctionObjects);
        field           alphaAirForTracer;
        expression      "alpha.air + 1e-8";
        store           true;
        autowrite       false;
        enabled         true;
        log             false;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    none;
    }

    tracerAirMassDensity
    {
        type            multiply;
        libs            (fieldFunctionObjects);
        fields          (alphaAirForTracer thermo:rho.air);
        result          alphaRhoAirForTracer;
        enabled         true;
        log             false;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    none;
    }

    tracerAirDensityFaces
    {
        type            surfaceInterpolate;
        libs            (fieldFunctionObjects);
        fields          ((thermo:rho.air airDensityFaceForTracer));
        enabled         true;
        log             false;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    none;
    }

    tracerAirVolumeFlux
    {
        // alphaPhi0.water is the conservative water volumetric flux produced
        // by MULES, so its complement is the air volumetric flux.
        type            exprField;
        libs            (fieldFunctionObjects);
        field           airVolumeFluxForTracer;
        expression      "phi - alphaPhi0.water";
        dimensions      [0 3 -1 0 0 0 0];
        store           true;
        autowrite       false;
        enabled         true;
        log             false;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    none;
    }

    tracerAirMassFlux
    {
        // Construct phase mass flux directly.  Subtracting water mass flux
        // from rhoPhi is not equivalent in this compressible solver and can
        // leave an O(water-flux) residual in nominally pure-water cells.
        type            exprField;
        libs            (fieldFunctionObjects);
        field           airMassFluxForTracer;
        expression      "airDensityFaceForTracer * airVolumeFluxForTracer";
        dimensions      [1 0 -1 0 0 0 0];
        store           true;
        autowrite       false;
        enabled         true;
        log             false;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    none;
    }

    pocketBodyTracerTransport
    {
        type            scalarTransport;
        libs            (solverFunctionObjects);
        field           pocketBodyTracer;
        phi             airMassFluxForTracer;
        rho             alphaRhoAirForTracer;
        schemesField    pocketBodyTracer;
        bounded01       true;
        D               0;
        tolerance       1e-8;
        nCorr           0;
        resetOnStartUp  false;
        enabled         true;
        log             false;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    writeTime;
        writeInterval   1;
    }

    probesPT
    {
        type            probes;
        libs            (sampling);
        fields          (p p_rgh alpha.water U pocketBodyTracer);
        probeLocations
        (
            (0.15 -0.025 1.25)     // PT1: riser wall, +0.80 m
            (0.15 -0.08  0.44)     // PT2: chamber top
            (0.15 -0.14  0.02)     // PT3: chamber front wall, +0.02 m
            (-0.30 0 0.379000) // PT4 crown
        );
        writeControl    adjustableRunTime;
        writeInterval   0.002;
    }

