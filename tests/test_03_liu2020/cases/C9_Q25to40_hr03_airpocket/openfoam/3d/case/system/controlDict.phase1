    totalMass
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        operation       volIntegrate;
        fields          (rho);
        writeControl    adjustableRunTime;
        writeInterval   0.01;
        writeFields     false;
    }

    waterVolume
