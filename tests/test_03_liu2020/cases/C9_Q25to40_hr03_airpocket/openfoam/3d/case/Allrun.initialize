#!/usr/bin/env bash
source /usr/lib/openfoam/openfoam2512/etc/bashrc
set -eo pipefail
cd "$(dirname "$0")"
NP="${OPENFOAM_NP:-4}"
rm -rf processor* postProcessing
foamListTimes -rm >/dev/null 2>&1 || true
rm -rf 0
cp -r 0.orig 0
setFields > log.setFields 2>&1
decomposePar -force > log.decomposePar 2>&1
trap 'cp system/controlDict.full system/controlDict' EXIT
cp system/controlDict.initialize system/controlDict
mpirun -np "$NP" compressibleInterFoam -parallel > log.initialize 2>&1
echo INITIALIZATION_DONE
