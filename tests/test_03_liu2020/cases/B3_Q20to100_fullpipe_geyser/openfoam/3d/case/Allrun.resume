#!/usr/bin/env bash
cd "$(dirname "$0")"

source /usr/lib/openfoam/openfoam2512/etc/bashrc
set -euo pipefail

if [[ ! -d processor0 ]]; then
    echo "No decomposed run found; use ./Allrun.solve." >&2
    exit 1
fi
if [[ ! -f system/decomposeParDict.runtime ]]; then
    echo "Missing runtime decomposition dictionary; use ./Allrun.solve." >&2
    exit 1
fi

NP="$(foamDictionary system/decomposeParDict.runtime \
    -entry numberOfSubdomains -value)"
if [[ -n "${OPENFOAM_NP:-}" && "$OPENFOAM_NP" != "$NP" ]]; then
    echo "OPENFOAM_NP=$OPENFOAM_NP does not match the existing $NP-way decomposition." >&2
    exit 1
fi
if (( NP > $(nproc) )); then
    echo "Existing $NP-way decomposition exceeds the $(nproc) available MPI slots." >&2
    exit 1
fi

if [[ -f system/controlDict.full-run ]]; then
    echo "Stale system/controlDict.full-run found; restore or remove it first." >&2
    exit 1
fi
cp system/controlDict system/controlDict.full-run
restore_control()
{
    if [[ -f system/controlDict.full-run ]]; then
        mv system/controlDict.full-run system/controlDict
    fi
}
trap restore_control EXIT
foamDictionary system/controlDict -entry startFrom -set latestTime >/dev/null
if [[ -n "${B3_END_TIME:-}" ]]; then
    foamDictionary system/controlDict -entry endTime -set "$B3_END_TIME" >/dev/null
fi

mpirun -np "$NP" compressibleInterIsoFoam -parallel \
    -decomposeParDict system/decomposeParDict.runtime \
    >> log.compressibleInterIsoFoam 2>&1
reconstructPar -latestTime > log.reconstructPar 2>&1
restore_control
trap - EXIT

echo "B3_3D_RESUME_DONE"
