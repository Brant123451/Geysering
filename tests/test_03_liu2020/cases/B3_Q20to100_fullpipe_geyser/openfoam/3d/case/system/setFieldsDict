FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}

// Same upstream free-surface initialisation as A2.  The B3 differences are
// the full downstream pipe and the chamber stage just above its crown.
defaultFieldValues
(
    volScalarFieldValue alpha.water 0
    volVectorFieldValue U (0 0 0)
);

regions
(
    // Numerical inlet headbox.
    boxToCell
    {
        box (-6.20 -1 -1) (-5.80 1 0.42);
        fieldValues (volScalarFieldValue alpha.water 1);
    }

    // Upstream pipe: six steps follow invert z = 0.18 - 0.01*x with the
    // approximately 0.08 m initial depth reported for A2.  The paper says
    // B3 differs from A2 only in its downstream condition.  U is Q0 divided
    // by the corresponding circular-segment area and follows the 1:100 axis.
    boxToCell
    {
        box (-5.82 -1 -1) (-4.83 1 0.318);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
            volVectorFieldValue U (1.70425 0 -0.0170425)
        );
    }
    boxToCell
    {
        box (-4.83 -1 -1) (-3.87 1 0.308);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
            volVectorFieldValue U (1.70425 0 -0.0170425)
        );
    }
    boxToCell
    {
        box (-3.87 -1 -1) (-2.90 1 0.299);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
            volVectorFieldValue U (1.70425 0 -0.0170425)
        );
    }
    boxToCell
    {
        box (-2.90 -1 -1) (-1.93 1 0.289);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
            volVectorFieldValue U (1.70425 0 -0.0170425)
        );
    }
    boxToCell
    {
        box (-1.93 -1 -1) (-0.97 1 0.279);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
            volVectorFieldValue U (1.70425 0 -0.0170425)
        );
    }
    boxToCell
    {
        box (-0.97 -1 -1) (0.00 1 0.270);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
            volVectorFieldValue U (1.70425 0 -0.0170425)
        );
    }

    // Declared B3 initial chamber stage: 0.30 m.  Its streamwise seed is
    // Q0 divided by the 0.30 x 0.30 m wetted section.
    boxToCell
    {
        box (-0.01 -1 -1) (0.31 1 0.30);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
            volVectorFieldValue U (0.222222 0 0)
        );
    }

    // Series-B defining initial condition: downstream circular pipe is full
    // and carries Q0 through its full-bore area.
    boxToCell
    {
        // Start at the chamber wall so this region cannot overwrite the
        // chamber air space above its declared 0.30 m water level.
        box (0.30 -1 -1) (6.26 1 1);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
            volVectorFieldValue U (0.324806 0 0)
        );
    }
);
