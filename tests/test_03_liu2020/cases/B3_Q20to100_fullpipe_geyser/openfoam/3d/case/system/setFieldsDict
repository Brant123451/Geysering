FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}

// Same upstream free-surface initialisation as A2.  The B3 differences are
// the full downstream pipe and the chamber stage just above its crown.
defaultFieldValues
(
    volScalarFieldValue alpha.water 0
);

regions
(
    // Numerical inlet headbox.
    boxToCell
    {
        box (-6.20 -1 -1) (-5.80 1 0.42);
        fieldValues (volScalarFieldValue alpha.water 1);
    }

    // Upstream pipe: six steps follow invert z = 0.18 - 0.01*x with
    // approximately 0.10 m initial depth.
    boxToCell
    {
        box (-5.82 -1 -1) (-4.83 1 0.338);
        fieldValues (volScalarFieldValue alpha.water 1);
    }
    boxToCell
    {
        box (-4.83 -1 -1) (-3.87 1 0.328);
        fieldValues (volScalarFieldValue alpha.water 1);
    }
    boxToCell
    {
        box (-3.87 -1 -1) (-2.90 1 0.319);
        fieldValues (volScalarFieldValue alpha.water 1);
    }
    boxToCell
    {
        box (-2.90 -1 -1) (-1.93 1 0.309);
        fieldValues (volScalarFieldValue alpha.water 1);
    }
    boxToCell
    {
        box (-1.93 -1 -1) (-0.97 1 0.299);
        fieldValues (volScalarFieldValue alpha.water 1);
    }
    boxToCell
    {
        box (-0.97 -1 -1) (0.00 1 0.290);
        fieldValues (volScalarFieldValue alpha.water 1);
    }

    // Declared B3 initial chamber stage: 0.30 m.
    boxToCell
    {
        box (-0.01 -1 -1) (0.31 1 0.30);
        fieldValues (volScalarFieldValue alpha.water 1);
    }

    // Series-B defining initial condition: downstream circular pipe is full.
    boxToCell
    {
        box (0.29 -1 -1) (6.26 1 1);
        fieldValues (volScalarFieldValue alpha.water 1);
    }
);
