#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

source /usr/lib/openfoam/openfoam2512/etc/bashrc

NP="${OPENFOAM_NP:-4}"
if (( NP < 1 )); then NP=1; fi

rm -rf processor* postProcessing
./Allrun.init

cp system/controlDict system/controlDict.full-run
restore_control()
{
    if [[ -f system/controlDict.full-run ]]; then
        mv system/controlDict.full-run system/controlDict
    fi
}
trap restore_control EXIT

foamDictionary system/controlDict -entry endTime -set 0.02 >/dev/null
foamDictionary system/controlDict -entry writeInterval -set 0.01 >/dev/null
foamDictionary system/controlDict -entry maxDeltaT -set 0.0002 >/dev/null

cp system/decomposeParDict system/decomposeParDict.runtime
foamDictionary system/decomposeParDict.runtime \
    -entry numberOfSubdomains -set "$NP" >/dev/null
decomposePar -force -decomposeParDict system/decomposeParDict.runtime \
    > log.decomposePar.smoke 2>&1

mpirun -np "$NP" compressibleInterFoam -parallel \
    > log.compressibleInterFoam.smoke 2>&1

reconstructPar -latestTime > log.reconstructPar.smoke 2>&1
restore_control
trap - EXIT

echo "B3_3D_SMOKE_DONE endTime=0.02"
