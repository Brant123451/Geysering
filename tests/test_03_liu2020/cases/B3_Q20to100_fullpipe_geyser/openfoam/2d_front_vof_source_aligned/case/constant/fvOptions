FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvOptions;
}

// This bound is far outside the expected B3 physical state. It prevents an
// isolated tetrahedral/interface overshoot from collapsing the adaptive time
// step and subsequently corrupting the thermodynamic update.
limitVelocityAll
{
    type            limitVelocity;
    selectionMode   all;
    max             50;
}
