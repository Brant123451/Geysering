#!/usr/bin/env bash
cd "$(dirname "$0")"

source /usr/lib/openfoam/openfoam2512/etc/bashrc
set -euo pipefail

foamListTimes -rm >/dev/null 2>&1 || true
rm -rf \
    0 \
    processor* \
    postProcessing \
    constant/polyMesh \
    b3_2d_front.msh \
    log.* \
    mesh-metadata.txt \
    system/decomposeParDict.runtime \
    system/controlDict.full-run

echo "B3_2D_FRONT_CLEAN"
