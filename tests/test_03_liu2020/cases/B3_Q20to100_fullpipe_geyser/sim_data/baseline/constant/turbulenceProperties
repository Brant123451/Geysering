FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}

// Retained from the A2 3-D source so the downstream condition remains the
// branch-defining physical change.  No coefficients are fitted to B3.
simulationType  RAS;

RAS
{
    RASModel        kOmegaSST;
    turbulence      on;
    printCoeffs     on;
}
