FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState perfectFluid;
    specie          specie;
    energy          sensibleInternalEnergy;
}

mixture
{
    specie
    {
        molWeight   18.01528;
    }

    equationOfState
    {
        // The paper gives about 305 m/s for pressure waves in the clear
        // acrylic pipe.  R=c^2 represents that measured pipe-plus-water
        // compliance in this fluid-only model.  rho0 is offset so that
        // rho(101325 Pa)=998.2 kg/m3 for perfectFluid: rho=rho0+p/R.
        R           93025;
        rho0        997.1107767;
    }

    thermodynamics
    {
        Cp          4182;
        Hf          0;
    }

    transport
    {
        mu          1.003e-3;
        Pr          7.0;
    }
}
