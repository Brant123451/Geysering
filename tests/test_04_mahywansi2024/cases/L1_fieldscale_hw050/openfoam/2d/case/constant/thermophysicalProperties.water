FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}

thermoType
{
    type                heRhoThermo;
    mixture             pureMixture;
    transport           const;
    thermo              hConst;
    equationOfState     perfectFluid;
    specie              specie;
    energy              sensibleInternalEnergy;
}

mixture
{
    specie
    {
        molWeight       18.01528;
    }
    equationOfState
    {
        R               3000;
        rho0            998.4;
    }
    thermodynamics
    {
        Cp              4182;
        Hf              0;
    }
    transport
    {
        mu              7.94e-04;
        Pr              7.0;
    }
}
