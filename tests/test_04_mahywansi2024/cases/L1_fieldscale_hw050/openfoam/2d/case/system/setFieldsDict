            volScalarFieldValue alpha.water 1
            volScalarFieldValue p_rgh 131178.038592
            volScalarFieldValue p 131178.038592
        );
    }

    // Partially filled dropshaft: hw/hd = 0.50.
    boxToCell
    {
        box (-0.0761 -1 0.0759) (0.0761 1 3.048);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
