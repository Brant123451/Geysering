FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}

dimensions      [0 2 -1 0 0 0 0];
internalField   uniform 1e-6;

boundaryField
{
    waterInlet  { type calculated; value uniform 1e-6; }
    waterOutlet { type calculated; value uniform 1e-6; }
    airInlet    { type calculated; value uniform 1e-6; }
    atmosphere  { type calculated; value uniform 1e-6; }
    walls       { type nutkWallFunction; value uniform 1e-6; }
    frontAndBack { type empty; }
}
