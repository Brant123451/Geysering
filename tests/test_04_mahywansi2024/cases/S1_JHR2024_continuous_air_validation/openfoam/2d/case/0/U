FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);

boundaryField
{
    waterInlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    waterOutlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    airInlet
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    ambientFloor
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    ambientSides
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    ambientTop
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    walls
    {
        type            noSlip;
    }
    frontAndBack
    {
        type            empty;
    }
}
