# Cursor project files
.cursor/*
!.cursor/Dockerfile

# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
venv/

# LaTeX build intermediates (final PDFs remain tracked)
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.log
*.out
*.spl
*.synctex.gz
*.toc

# OpenFOAM generated runtime state
**/openfoam/**/processor*/
**/openfoam/**/postProcessing/
**/openfoam/**/dynamicCode/
**/openfoam/**/constant/polyMesh/
**/openfoam/**/caseA3d.msh
**/openfoam/**/decomposeParDict.runtime
**/openfoam/**/towerCrossSections.runtime
**/openfoam/**/log.*
**/openfoam/2d/[0-9]*/
**/openfoam/3d/[0-9]*/
!**/openfoam/2d/0.orig/
!**/openfoam/2d/0.orig/**
!**/openfoam/3d/0.orig/
!**/openfoam/3d/0.orig/**

# Generated frame sequences and viewers
**/frames/
**/riser_frames/
**/*_frame_viewer/

# Compiled legacy solver artifacts
*.o
*.obj
*.pdb
*.exe
*.dll
*.mod
*.so
**/x64/Debug/
tests/test_02_cong2017/_archive/legacy_real_solver/runs/

# Historical generated bundles remain available locally but are not required by
# Cloud Agents. Their active code/data counterparts live under cases/ or studies/.
tests/test_01_vw2011/_archive/legacy_reproduction/
tests/test_02_cong2017/_archive/legacy_outputs/

# Migration staging and local scratch files
tests/**/_staging_legacy/
tests/**/cases/**/_*.txt
/_tmp_*
/_slugdbg*
*.bak
*.bak-*
*.bak.*
